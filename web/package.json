{
  "name": "mangarr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && touch dist/.gitkeep",
    "typecheck": "tsc --noEmit",
    "gen": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "node scripts/check-colors.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf:phone": "playwright test -c playwright.perf.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
