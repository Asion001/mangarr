#!/usr/bin/env sh
# Runs what CI runs before a push leaves: the Go gate when Go code changed,
# the web gate (browser tests included) when web/ changed. Turn it on with
# `make hooks`; `git push --no-verify` skips it.
set -eu
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
changed=""
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    range=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    [ -n "$range" ] && range="$range..$local_sha" || range=$local_sha
  else
    range="$remote_sha..$local_sha"
  fi
  changed="$changed
$(git diff --name-only "$range" 2>/dev/null || git ls-files)"
done
go=false web=false
echo "$changed" | grep -qE '^(cmd|internal)/|^go\.(mod|sum)$|^scripts/' && go=true
echo "$changed" | grep -qE '^web/' && web=true
# the API description feeds both sides
echo "$changed" | grep -qE '^web/(openapi\.json|src/api/schema\.d\.ts)$' && go=true
$go || $web || exit 0
# check what is being pushed, not the working tree's uncommitted files
if [ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: commit or stash your changes first, the checks run on the working tree" >&2
  exit 1
fi
if $go; then
  echo "pre-push: Go checks"
  if [ -z "${MANGARR_TEST_POSTGRES:-}" ]; then
    echo "pre-push: MANGARR_TEST_POSTGRES is not set, the tests run on SQLite only" >&2
  fi
  "$root/scripts/gate.sh"
fi
if $web; then
  echo "pre-push: web checks"
  "$root/scripts/gate-web.sh"
fi
